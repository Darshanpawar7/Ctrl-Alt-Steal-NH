# Copy this file to .env for running on your laptop. On Render, set these in
# the service's Environment tab instead (never commit real passwords).
ADMIN_PASSWORD=change-me-admin
VOLUNTEER_PASSWORD=change-me-desk

# Optional. Without it, the game is saved in the .data folder.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional locally. On Render, set it to your Vercel address, e.g.
# ALLOWED_ORIGINS=https://ctrl-alt-steal.vercel.app
