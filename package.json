{
  "name": "ctrl-alt-steal",
  "private": true,
  "version": "1.0.0",
  "description": "Live game platform for Ctrl+Alt+Steal, Neural Hive's AI heist challenge at PES University.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/main.js",
    "laptop": "npm run build && npm run build:server && npm start",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "load-test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "immer": "^11.2.9",
    "motion": "^14.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
